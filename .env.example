# ===================================================
# CONFIGURAÇÃO DO BOT WHATSAPP
# ===================================================

# Chave de API da OpenAI (Obrigatório para respostas inteligentes)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo da OpenAI (Opcional, padrão: gpt-4o-mini)
# Outras opções: gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Quantidade máxima de mensagens no histórico por contato (padrão: 10)
MAX_HISTORY_MESSAGES=10
