# ===================================================
# CONFIGURAÇÃO DO BOT WHATSAPP & PAINEL ADMINISTRATIVO
# ===================================================

# Chave de API da OpenAI (Obrigatório para respostas inteligentes)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo da OpenAI (Opcional, padrão: gpt-4o-mini)
# Outras opções: gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Quantidade máxima de mensagens no histórico por contato (padrão: 10)
MAX_HISTORY_MESSAGES=10

# Credenciais de Acesso ao Painel Administrativo Web (Obrigatório para segurança)
ADMIN_USER=admin
ADMIN_PASSWORD=sua_senha_segura_aqui

# Porta do Servidor Web (Padrão: 3000)
PORT=3000

# Chave secreta de sessão (Opcional, gera aleatória se omitida)
SESSION_SECRET=art_artigos_militares_secret_session_key
